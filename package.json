{
  "name": "securebank",
  "version": "1.0.0",
  "private": true,
  "description": "SecureBank - intentionally vulnerable digital banking ecosystem for AppSec training",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=services/api",
    "db:migrate": "npm run db:migrate --workspace=services/api",
    "db:seed": "npm run db:seed --workspace=services/api",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  }
}
