// SecureBank data model (SB-004)
// Single Prisma schema shared by all backend modules; each module's model.js
// exposes only the data-access functions relevant to its own domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access (owned by the "users" and "auth" modules)
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id                 String    @id @default(uuid())
  fullName           String
  email              String    @unique
  passwordHash       String
  phoneNumber        String?
  role               Role      @relation(fields: [roleId], references: [id])
  roleId             String
  isActive           Boolean   @default(true)
  isTwoFactorEnabled Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts            Account[]
  beneficiaries       Beneficiary[]
  supportTickets      SupportTicket[]
  supportMessages     SupportMessage[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]         @relation("AuditEventActor")
  challengeProgress   ChallengeProgress[]
  environments        Environment[]
  teamMembership      TeamMembership?
  achievements        UserAchievement[]
  scoreEvents         ScoreEvent[]
  helpRequests        HelpRequest[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Core banking (owned by the "accounts", "beneficiaries", "transactions" and
// "transfers" modules)
// ---------------------------------------------------------------------------

enum AccountType {
  CURRENT
  SAVINGS
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

model Account {
  id               String        @id @default(uuid())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  accountNumber    String        @unique
  accountType      AccountType
  status           AccountStatus @default(ACTIVE)
  currency         String        @default("NGN")
  balance          Decimal       @default(0) @db.Decimal(18, 2)
  availableBalance Decimal       @default(0) @db.Decimal(18, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  transactions      Transaction[]
  outgoingTransfers Transfer[]    @relation("TransferSourceAccount")
  incomingTransfers Transfer[]    @relation("TransferDestinationAccount")

  @@index([userId])
  @@map("accounts")
}

model Beneficiary {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  nickname      String?
  accountName   String
  accountNumber String
  bankName      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transfers Transfer[]

  @@index([userId])
  @@map("beneficiaries")
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum TransactionStatus {
  SUCCESSFUL
  PENDING
  REVERSED
  FAILED
}

model Transaction {
  id           String             @id @default(uuid())
  account      Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId    String
  reference    String             @unique
  type         TransactionType
  status       TransactionStatus  @default(PENDING)
  amount       Decimal            @db.Decimal(18, 2)
  balanceAfter Decimal            @db.Decimal(18, 2)
  description  String
  category     String?
  channel      String             @default("SecureBank Online")
  occurredAt   DateTime           @default(now())
  createdAt    DateTime           @default(now())

  transfer Transfer?

  @@index([accountId])
  @@map("transactions")
}

enum TransferStatus {
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
  PENDING
}

model Transfer {
  id                   String         @id @default(uuid())
  reference            String         @unique
  sourceAccount        Account        @relation("TransferSourceAccount", fields: [sourceAccountId], references: [id])
  sourceAccountId      String
  destinationAccount   Account?       @relation("TransferDestinationAccount", fields: [destinationAccountId], references: [id])
  destinationAccountId String?
  beneficiary          Beneficiary?   @relation(fields: [beneficiaryId], references: [id])
  beneficiaryId        String?
  amount               Decimal        @db.Decimal(18, 2)
  fee                  Decimal        @default(0) @db.Decimal(18, 2)
  description          String?
  status               TransferStatus @default(PROCESSING)
  transaction          Transaction?   @relation(fields: [transactionId], references: [id])
  transactionId        String?        @unique
  otpTokenHash         String?
  otpExpiresAt         DateTime?
  otpAttempts          Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([sourceAccountId])
  @@map("transfers")
}

// ---------------------------------------------------------------------------
// Support (owned by the "support" module)
// ---------------------------------------------------------------------------

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id        String                @id @default(uuid())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  subject   String
  category  String
  status    SupportTicketStatus   @default(OPEN)
  priority  SupportTicketPriority @default(MEDIUM)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  messages SupportMessage[]

  @@index([userId])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  sender    User          @relation(fields: [senderId], references: [id])
  senderId  String
  message   String
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

// ---------------------------------------------------------------------------
// Observability (owned by the "audit" module)
// ---------------------------------------------------------------------------

enum AuditEventResult {
  SUCCESS
  DENIED
  ERROR
}

model AuditEvent {
  id            String           @id @default(uuid())
  actor         User?            @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId       String?
  actorRole     String?
  action        String
  resourceType  String?
  resourceId    String?
  result        AuditEventResult
  ipAddress     String?
  userAgent     String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime         @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Challenge framework (owned by the "challenges" module) - SB-012
// ---------------------------------------------------------------------------

enum ChallengeDifficulty {
  EXPLORER
  ENGINEER
  SPECIALIST
}

// Per-participant progress on a challenge. LOCKED/AVAILABLE/ACTIVE/SOLVED
// drives the UI; flagState is the SB-013 feature flag that lets a
// participant's own environment be independently vulnerable, patched or
// reset without touching anyone else's.
enum ChallengeStatus {
  LOCKED
  AVAILABLE
  ACTIVE
  SOLVED
}

enum ChallengeFlagState {
  VULNERABLE
  PATCHED
}

model Lab {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenges   Challenge[]
  environments Environment[]
  helpRequests HelpRequest[]

  @@map("labs")
}

model Challenge {
  id                       String              @id @default(uuid())
  lab                      Lab                 @relation(fields: [labId], references: [id])
  labId                    String
  code                     String              @unique
  title                    String
  difficulty               ChallengeDifficulty
  order                    Int                 @default(0)
  scenario                 String
  objective                String
  learningObjective        String
  prerequisites            String?
  startingState            String?
  expectedSecurityBoundary String?
  intendedWeakness         String
  validationType           String              @default("automated")
  answerKey                String?
  evidenceBundle           Json?
  remediationDiff          Json?
  points                   Int
  remediationPoints        Int?
  isHidden                 Boolean             @default(false)
  remediationGuide         String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  hints    ChallengeHint[]
  progress ChallengeProgress[]

  @@index([labId])
  @@map("challenges")
}

model ChallengeHint {
  id          String    @id @default(uuid())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String
  order       Int
  cost        Int
  content     String

  @@index([challengeId])
  @@map("challenge_hints")
}

model ChallengeProgress {
  id              String             @id @default(uuid())
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  challenge       Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId     String
  status          ChallengeStatus    @default(LOCKED)
  flagState       ChallengeFlagState @default(VULNERABLE)
  hintsRevealed   Int                @default(0)
  pointsAwarded   Int                @default(0)
  evidence        Json?
  submittedAnswer String?
  attempts        Int                @default(0)
  solvedAt        DateTime?
  remediatedAt    DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([userId, challengeId])
  @@index([challengeId])
  @@map("challenge_progress")
}

// ---------------------------------------------------------------------------
// Lab environments (owned by the "environments" module)
// ---------------------------------------------------------------------------

enum EnvironmentStatus {
  PROVISIONING
  RUNNING
  EXPIRED
  TERMINATED
  UNHEALTHY
}

model Environment {
  id         String            @id @default(uuid())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lab        Lab               @relation(fields: [labId], references: [id])
  labId      String
  externalId String            @unique
  status     EnvironmentStatus @default(PROVISIONING)
  expiresAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
  @@map("environments")
}

// ---------------------------------------------------------------------------
// Gamification (owned by the "gamification" module) - SB-057..065
// ---------------------------------------------------------------------------

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  memberships TeamMembership[]

  @@map("teams")
}

model TeamMembership {
  id       String   @id @default(uuid())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String   @unique
  joinedAt DateTime @default(now())

  @@index([teamId])
  @@map("team_memberships")
}

model Achievement {
  id          String @id @default(uuid())
  code        String @unique
  name        String
  description String
  icon        String?

  unlocks UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model ScoreEvent {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  points      Int
  reason      String
  challengeId String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("score_events")
}

// ---------------------------------------------------------------------------
// Facilitator help queue (owned by the "helpRequests" module) - SB-064
// ---------------------------------------------------------------------------

enum HelpRequestStatus {
  OPEN
  RESOLVED
}

model HelpRequest {
  id         String            @id @default(uuid())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lab        Lab?              @relation(fields: [labId], references: [id])
  labId      String?
  reason     String
  status     HelpRequestStatus @default(OPEN)
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@map("help_requests")
}

// ---------------------------------------------------------------------------
// Operational feature flags (owned by the "systemFlags" module) - SB-072
// Sandbox-wide emergency controls: stop provisioning, disable a lab, etc.
// ---------------------------------------------------------------------------

model SystemFlag {
  key       String   @id
  value     Boolean  @default(false)
  reason    String?
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("system_flags")
}
